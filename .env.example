# Supabase Environment Configuration Examples
# Copy this file to .env.staging, .env.production, or .env.development
# and replace the placeholder values with actual Supabase project credentials.
# Never commit actual .env files with real credentials to version control.

# Supabase Project URL
# Replace with your Supabase project URL from the Supabase dashboard
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Supabase Anon/Publishable Key
# Replace with your Supabase anon/publishable key from the Supabase dashboard
# Never use service_role keys in frontend/client-side code
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Environment identifier
# Used to distinguish between different environments at build time
ENVIRONMENT=staging