    "claim_notifications_def": "CREATE OR REPLACE FUNCTION public.claim_notifications(p_limit integer DEFAULT 20)\n RETURNS SETOF notification_outbox\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  return query\n  update public.notification_outbox o\n     set status = 'processing', locked_at = now(), attempts = o.attempts + 1\n   where o.id in (\n     select x.id from public.notification_outbox x\n      where (x.status = 'pending'\n             or (x.status = 'processing' and x.locked_at < now() - interval '10 minutes')\n             or (x.status = 'failed' and x.attempts < 5\n                 and x.locked_at < now() - interval '5 minutes'))\n      order by x.created_at\n      limit greatest(1, least(p_limit, 100))\n      for update skip locked\n   )\n  returning o.*;\nend;\n$function$\n",
    "claim_notifications_acl": "{postgres=X/postgres,service_role=X/postgres}",
